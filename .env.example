# 复制为 .env 后填写本地值；.env 已被 .gitignore 忽略，不要提交真实凭据。

# --- MySQL（compose.yaml 与应用共用）---
STOCKHOLD_DB_PORT=33306
STOCKHOLD_DB_USER=stockhold
STOCKHOLD_DB_PASSWORD=change-me
STOCKHOLD_DB_ROOT_PASSWORD=change-me-too

# 应用连接串：会话固定 UTC、READ COMMITTED，锁等待 1 秒（实验值）。
STOCKHOLD_DB_URL="jdbc:mysql://127.0.0.1:33306/stockhold?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&sessionVariables=transaction_isolation='READ-COMMITTED',innodb_lock_wait_timeout=1&characterEncoding=UTF-8"
STOCKHOLD_DB_POOL_SIZE=16

# --- 应用 ---
STOCKHOLD_SERVER_ADDRESS=127.0.0.1
STOCKHOLD_SERVER_PORT=8080
# 管理接口令牌（仅 dev profile 开放管理接口）。
STOCKHOLD_ADMIN_TOKEN=change-me-admin-token
# 第二阶段候选优化：多维度预留使用 UNION ALL 锁定读。
STOCKHOLD_UNION_ALL_SELECT=false

# --- 可选实验组件（compose profile）---
# Redis：docker compose --profile migration up -d，供影子迁移实验（应用 migration profile）使用。
STOCKHOLD_REDIS_PORT=36379
# ProxySQL：docker compose --profile proxysql up -d；管理端口只在 compose 网络内可达。
STOCKHOLD_PROXYSQL_PORT=36033
# STOCKHOLD_PROXYSQL_ADMIN_PASSWORD=   # 未设置时沿用 STOCKHOLD_DB_PASSWORD

# --- 测试：指向可随时重置的隔离数据库；未设置时使用 Testcontainers（需要 Docker）---
# compose 首次初始化时会创建 stockhold_test 库；观察账号只读 performance_schema，供锁形态测试使用。
STOCKHOLD_TEST_OBSERVER_USER=stockhold_observer
STOCKHOLD_TEST_OBSERVER_PASSWORD=change-me-observer
# STOCKHOLD_TEST_JDBC_URL=jdbc:mysql://127.0.0.1:33306/stockhold_test
# STOCKHOLD_TEST_DB_USER=stockhold
# STOCKHOLD_TEST_DB_PASSWORD=change-me
